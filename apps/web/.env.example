# Next.js public configuration
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Set these on the Convex deployment, never in NEXT_PUBLIC_ variables.
# EMAIL_CODE_PEPPER: random secret with at least 32 characters.
# RESEND_API_KEY: a Resend key; the free plan can be used within its limits.
# RESEND_FROM must be a sender authorized by your Resend configuration.
EMAIL_CODE_PEPPER=
RESEND_API_KEY=
RESEND_FROM=Joti <onboarding@resend.dev>
RESEND_REPLY_TO=
